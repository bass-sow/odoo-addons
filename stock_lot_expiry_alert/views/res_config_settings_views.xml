<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock.lot.expiry.alert</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="product_expiry.res_config_settings_view_form_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='group_expiry_date_on_delivery_slip']" position="after">
                <setting id="expiry_alert_digest" company_dependent="1"
                         string="Expiry Alerts"
                         help="Daily email with the lots in stock that are about to expire">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="expiry_warning_days" string="Days before expiry" class="col-lg-5 o_light_label"/>
                            <field name="expiry_warning_days" class="col-lg-2"/>
                        </div>
                        <div class="row">
                            <label for="expiry_responsible_id" string="Send to" class="col-lg-5 o_light_label"/>
                            <field name="expiry_responsible_id" class="col-lg-6"
                                   options="{'no_create': True}"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
